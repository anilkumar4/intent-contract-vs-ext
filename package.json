{
  "name": "intent-contract",
  "displayName": "Intent Contract",
  "description": "Detects changes that violate a local AI task contract.",
  "version": "0.3.0",
  "publisher": "anilkumar4",
  "repository": {
    "type": "git",
    "url": "https://github.com/anilkumar4/intent-contract-vs-ext.git"
  },
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:intentContractFindings",
    "workspaceContains:.intent/*.yaml",
    "workspaceContains:.intent/*.yml"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "intent-contract": "./dist/cli.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "intentContract.start",
        "title": "Intent Contract: Start Contract"
      },
      {
        "command": "intentContract.stop",
        "title": "Intent Contract: Stop Contract"
      },
      {
        "command": "intentContract.recheck",
        "title": "Intent Contract: Re-check Now"
      },
      {
        "command": "intentContract.createTemplate",
        "title": "Intent Contract: Create Contract From Template"
      },
      {
        "command": "intentContract.copyViolations",
        "title": "Intent Contract: Copy Violations For Agent"
      },
      {
        "command": "intentContract.revertFile",
        "title": "Intent Contract: Revert File to Baseline",
        "icon": "$(discard)"
      },
      {
        "command": "intentContract.waiveFinding",
        "title": "Intent Contract: Waive Finding",
        "icon": "$(pass)"
      },
      {
        "command": "intentContract.configureAgents",
        "title": "Intent Contract: Configure AI Agents & MCP"
      },
      {
        "command": "intentContract.exportArchitectureDrift",
        "title": "Intent Contract: Export Architecture Drift Diagram"
      },
      {
        "command": "intentContract.openDiff",
        "title": "Intent Contract: Open Diff vs Baseline",
        "icon": "$(diff)"
      },
      {
        "command": "intentContract.openGuide",
        "title": "Intent Contract: Open Vibe Coding Guide",
        "icon": "$(book)"
      },
      {
        "command": "intentContract.visualBuilder",
        "title": "Intent Contract: Visual Contract Builder",
        "icon": "$(symbol-event)"
      },
      {
        "command": "intentContract.openWalkthrough",
        "title": "Intent Contract: Getting Started Walkthrough",
        "icon": "$(rocket)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "intent-contract-sidebar",
          "title": "Intent Contract",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "intent-contract-sidebar": [
        {
          "id": "intentContractFindings",
          "name": "Intent Contract Findings",
          "icon": "icon.png",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "configuration": {
      "title": "Intent Contract",
      "properties": {
        "intentContract.debounce": {
          "type": "number",
          "default": 300,
          "description": "Debounce delay in milliseconds before re-checking after file changes."
        },
        "intentContract.autoCheck": {
          "type": "boolean",
          "default": true,
          "description": "Automatically verify the contract when files change."
        },
        "intentContract.ignoredPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional glob patterns to ignore during contract verification."
        },
        "intentContract.severityOverrides": {
          "type": "object",
          "default": {},
          "description": "Rule-specific severity overrides."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "intentContract.visualBuilder",
          "when": "view == intentContractFindings",
          "group": "navigation@1"
        },
        {
          "command": "intentContract.openGuide",
          "when": "view == intentContractFindings",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "intentContract.openDiff",
          "when": "view == intentContractFindings && viewItem == intentFinding",
          "group": "inline@1"
        },
        {
          "command": "intentContract.revertFile",
          "when": "view == intentContractFindings && viewItem == intentFinding",
          "group": "inline@2"
        },
        {
          "command": "intentContract.waiveFinding",
          "when": "view == intentContractFindings && viewItem == intentFinding",
          "group": "inline@3"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "intentContractWalkthrough",
        "title": "Getting Started with Intent Contract",
        "description": "Learn how to safely vibe code with autonomous AI agents using locked intent contracts and guardrails.",
        "steps": [
          {
            "id": "welcome",
            "title": "Welcome to Intent Contract",
            "description": "Intent Contract is the safety harness for AI coding. It prevents autonomous agents from silent scope creep, faking green tests, and eroding system architecture.\\n\\n[Open Vibe Coding Guide](command:intentContract.openGuide)",
            "media": {
              "markdown": "walkthrough/welcome.md"
            }
          },
          {
            "id": "createContract",
            "title": "Define Your Task Contract",
            "description": "Declare what files and symbols your AI agent is allowed to modify, and what is forbidden.\\n\\n[Open Visual Contract Builder](command:intentContract.visualBuilder)",
            "media": {
              "markdown": "walkthrough/create-contract.md"
            }
          },
          {
            "id": "startSession",
            "title": "Start Session & Lock Baseline",
            "description": "Intent Contract captures a pristine baseline snapshot in Git. Changes made by your agent will be evaluated against this baseline in real time.\\n\\n[Start Contract Session](command:intentContract.start)",
            "media": {
              "markdown": "walkthrough/start-session.md"
            }
          },
          {
            "id": "configureAgents",
            "title": "Connect Your AI Agent & MCP",
            "description": "Generate prompt rules for Cursor, Claude Code, GitHub Copilot, and Google Antigravity, and install Git pre-push hooks.\\n\\n[Configure AI Agents & Hooks](command:intentContract.configureAgents)",
            "media": {
              "markdown": "walkthrough/configure-agents.md"
            }
          },
          {
            "id": "triageFindings",
            "title": "Monitor, Revert & Push",
            "description": "Inspect live diagnostics in the editor and sidebar. Revert hallucinated files back to the baseline with one click.\\n\\n[Open Intent Contract Sidebar](command:workbench.view.extension.intent-contract-sidebar)",
            "media": {
              "markdown": "walkthrough/triage.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npm run compile && node ./test/smoke/run.js",
    "build": "npm run compile && vsce package --allow-missing-repository --out intent-contract.vsix"
  },
  "dependencies": {
    "picomatch": "^4.0.2",
    "yaml": "^2.5.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@azure/msal-node": "7.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
